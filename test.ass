Dialogue: 0,0:00:16.70,0:00:18.73,Italics,,0,0,0,,...الثروة والشهرة والسلطة
Dialogue: 0,0:00:18.73,0:00:20.63,Italics,,0,0,0,,،الرجل الذي نال كل شيء في العالم
Dialogue: 0,0:00:20.63,0:00:22.94,Italics,,0,0,0,,.ملك القراصنة، غولد روجر
Dialogue: 0,0:00:22.94,0:00:26.81,Italics,,0,0,0,,قادت كلماته التي ألقاها قبل\N.موته بالناس إلى البحار
Dialogue: 0,0:00:26.81,0:00:30.64,Italics,,0,0,0,,!كنزي؟ سأعطيكم إياه إن أردتموه
Dialogue: 0,0:00:30.64,0:00:34.21,Italics,,0,0,0,,!جدوه! تركت كل ما هو موجود في هذا العالم فيه
Dialogue: 0,0:00:36.82,0:00:41.56,Italics,,0,0,0,,!وبهذا، يتوجه الرجال نحو غراند لاين لملاحقة أحلامهم
Dialogue: 0,0:00:41.56,0:00:45.46,Italics,,0,0,0,,!دخل العالم في عصر قراصنة عظيم
Dialogue: 0,0:00:45.46,0:00:50.83,OS,,0,0,0,,سنجمع كل أحلامنا
Dialogue: 0,0:00:50.83,0:00:56.74,OS,,0,0,0,,ونبحر باحثين عن شيء، باحثين عن
Dialogue: 0,0:00:56.74,0:00:58.24,OS,,0,0,0,,!ون بيس
Dialogue: 0,0:01:02.94,0:01:08.58,OS,,0,0,0,,لا تجلب البوصلات سوى التأخيرات
Dialogue: 0,0:01:08.58,0:01:14.32,OS,,0,0,0,,هذيان مع سخونة، آخذ مقود السفينة
Dialogue: 0,0:01:14.32,0:01:26.43,OS,,0,0,0,,إن تم التحقق من خريطة الكنز المغبرة\N!فإنها ليست أسطورة إذًا
Dialogue: 0,0:01:26.43,0:01:32.14,OS,,0,0,0,,،عندما يتعلق الأمر بالأعاصير الشخصية
Dialogue: 0,0:01:32.14,0:01:37.44,OS,,0,0,0,,فاركب مع إيقاع أحدهم الحيوي فحسب
Dialogue: 0,0:01:37.44,0:01:41.11,OS,,0,0,0,,!وتظاهر أنها غير موجودة
Dialogue: 0,0:01:41.11,0:01:46.62,OS,,0,0,0,,سنجمع كل أحلامنا
Dialogue: 0,0:01:46.62,0:01:52.33,OS,,0,0,0,,ونبحر باحثين عن شيء، باحثين عن
Dialogue: 0,0:01:52.33,0:01:58.57,OS,,0,0,0,,عملة في جيبي، وتريد أن تصبح صديقي؟
Dialogue: 0,0:01:58.57,0:02:03.94,OS,,0,0,0,,!إننا... إننا في رحلة بحرية
Dialogue: 0,0:02:03.94,0:02:05.01,OS,,0,0,0,,!إننا كذلك
Dialogue: 0,0:02:10.01,0:02:12.35,Default,,0,0,0,,...إنّ هذين يعترضان الطريق
Dialogue: 0,0:02:15.25,0:02:18.15,Default,,0,0,0,,...لقد فعلها-\N...القط السارق-
Dialogue: 0,0:02:18.15,0:02:22.39,Default,,0,0,0,,...لا أجيد أسلوب السيف الواحد جيّدًا، ولكن
Dialogue: 0,0:02:22.39,0:02:24.86,Default,,0,0,0,,!هيّا بنا يا بوتشي
Dialogue: 0,0:02:24.86,0:02:27.19,Default,,0,0,0,,!أجل، لنفعلها يا شامو
Dialogue: 0,0:02:31.57,0:02:35.57,Default,,0,0,0,,!سحقًا! لو كان لديّ سيف آخر فحسب
Dialogue: 0,0:02:37.44,0:02:39.71,Default,,0,0,0,,...لو تمكنتُ من إعطائه سيفيه
Dialogue: 0,0:02:43.64,0:02:46.31,Default,,0,0,0,,ما الذي تريدينه بالسيفين؟
Dialogue: 0,0:02:48.31,0:02:57.19,Ep Title,,0,0,0,,{\fad(1000,1000)\fs50}!عودة لوفي! مقاومة الآنسة كايا اليائسة
Dialogue: 0,0:02:51.22,0:02:56.02,Default,,0,0,0,,!عودة لوفي"\N"!مقاومة الآنسة كايا اليائسة
Dialogue: 0,0:03:35.93,0:03:40.40,Default,,0,0,0,,من كان يتخيل أن \N...يعيقكم هؤلاء الأطفال
Dialogue: 0,0:03:40.40,0:03:44.04,Default,,0,0,0,,...كم انحدر مستوى قراصنة القط الأسود
Dialogue: 0,0:03:46.14,0:03:50.14,Default,,0,0,0,,!أليس كذلك يا جانغو؟
Dialogue: 0,0:03:54.21,0:04:03.89,Default,,0,0,0,,لـ-لكن... قلتَ أنّ ذلك\N!الطفل لن يسبب أيّ مشكلة
Dialogue: 0,0:04:05.93,0:04:09.26,Default,,0,0,0,,.صحيح، قلت ذلك
Dialogue: 0,0:04:09.26,0:04:16.54,Default,,0,0,0,,ولكن ما بذلك؟ كنّا نعرف أنّه\N.سيعارضنا منذ وقت طويل
Dialogue: 0,0:04:16.54,0:04:19.21,Default,,0,0,0,,...الشيء الوحيد الذي لم أحسب حسابه
Dialogue: 0,0:04:19.21,0:04:22.48,Default,,0,0,0,,!هو ضعفكم
Dialogue: 0,0:04:22.48,0:04:25.11,Default,,0,0,0,,نـ-نحن... ضعاف؟
Dialogue: 0,0:04:25.11,0:04:27.11,Default,,0,0,0,,!من هم الضعاف؟
Dialogue: 0,0:04:27.11,0:04:30.12,Default,,0,0,0,,!انتبه لما تقوله أيّها القائد كورو
Dialogue: 0,0:04:31.92,0:04:34.62,Default,,0,0,0,,...كنتَ قويًا بالفعل
Dialogue: 0,0:04:34.62,0:04:36.79,Default,,0,0,0,,!ولكن ذلك كان قبل ثلاث سنوات
Dialogue: 0,0:04:36.79,0:04:42.06,Default,,0,0,0,,لم نكن نلهو حين كنت\N!تعيش هانئًا في هذه القرية
Dialogue: 0,0:04:42.06,0:04:47.97,Default,,0,0,0,,صحيح! هاجمنا العديد من المدن\N!وأغرقنا الكثير من القراصنة في البحر
Dialogue: 0,0:04:49.64,0:04:52.37,Default,,0,0,0,,ما الذي ترميان إليه؟
Dialogue: 0,0:04:52.37,0:04:55.41,Default,,0,0,0,,!أنت لم تفعل شيئًا في ثلاث سنوات
Dialogue: 0,0:04:55.41,0:04:59.21,Default,,0,0,0,,ويستحيل لك أن تهزم \N!الأخوين مياوبان في الحاضر
Dialogue: 0,0:05:03.05,0:05:05.82,Default,,0,0,0,,!توقفا يا بوتشي وشامو
Dialogue: 0,0:05:11.86,0:05:14.59,Default,,0,0,0,,!لم تعد قائدنا
Dialogue: 0,0:05:14.59,0:05:17.36,Default,,0,0,0,,!المعذرة، ولكننا سنقتلك
Dialogue: 0,0:05:37.22,0:05:42.16,Default,,0,0,0,,!مـ-متى تسلّل إلى خلفهم؟\N...وهذه الأسلحة
Dialogue: 0,0:05:44.72,0:05:47.49,Default,,0,0,0,,...من
Dialogue: 0,0:05:47.49,0:05:50.96,Default,,0,0,0,,!من ستقتلان؟
Dialogue: 0,0:05:50.96,0:05:53.27,Default,,0,0,0,,...تسلّل-\N!خلفنا-
Dialogue: 0,0:05:57.10,0:05:59.44,Default,,0,0,0,,!اختفى
Dialogue: 0,0:06:05.11,0:06:08.62,Default,,0,0,0,,...ها هي! قدم التسلّل
Dialogue: 0,0:06:08.62,0:06:10.62,Default,,0,0,0,,قدم التسلل؟
Dialogue: 0,0:06:17.72,0:06:19.86,Default,,0,0,0,,.أنتما محقان
Dialogue: 0,0:06:24.66,0:06:28.94,Default,,0,0,0,,.أشعر بالفتور نوعًا ما
Dialogue: 0,0:06:28.94,0:06:30.24,Default,,0,0,0,,إنّه يتعامل معهما كالأطفال
Dialogue: 0,0:06:30.24,0:06:34.17,Default,,0,0,0,,!بعد أن تفوقا على زورو
Dialogue: 0,0:06:35.18,0:06:40.25,Default,,0,0,0,,حركة القدم المتسللة التي يستعملها\N.هذا الرجل هي تقنية تنقل ساكن
Dialogue: 0,0:06:40.25,0:06:46.39,Default,,0,0,0,,حتّى مجموعة من 50 قاتل\N!قد يُقتلون قبل أن يشعرون به
Dialogue: 0,0:06:46.39,0:06:51.16,Default,,0,0,0,,!يستحيل لنا أن نهرب من خطته
Dialogue: 0,0:06:51.16,0:06:57.73,Default,,0,0,0,,واقشعر بدني بعد رؤية عادته\N!هذه ثانية بعد ثلاث سنوات
Dialogue: 0,0:06:57.73,0:07:01.17,Default,,0,0,0,,طريقته الغريبة برفع نظارته\Nلتجنب قطع وجهه
Dialogue: 0,0:07:01.17,0:07:03.64,Default,,0,0,0,,...بمخالب القط تلك
Dialogue: 0,0:07:03.64,0:07:06.81,Default,,0,0,0,,!هي دليل على أنّه لم ينسَ كيف يقاتل
Dialogue: 0,0:07:26.69,0:07:30.13,Default,,0,0,0,,يبدو أنّي أصبحت طيّبًا قليلًا
Dialogue: 0,0:07:30.13,0:07:35.60,Default,,0,0,0,,...خلال سنواتي الثلاث على اليابسة
Dialogue: 0,0:07:35.60,0:07:38.27,Default,,0,0,0,,.سأمنحكم خمس دقائق
Dialogue: 0,0:07:39.87,0:07:44.21,Default,,0,0,0,,إلّم تستطيعوا الاعتناء بالأمور\N...هنا خلال خمس دقائق
Dialogue: 0,0:07:45.61,0:07:48.95,Default,,0,0,0,,...فسأقتلكم جميعًا
Dialogue: 0,0:07:51.75,0:07:54.95,Default,,0,0,0,,!بيديّ هاتين
Dialogue: 0,0:08:03.50,0:08:05.06,Default,,0,0,0,,...خمس دقائق
Dialogue: 0,0:08:05.06,0:08:07.57,Default,,0,0,0,,!يمكننا فعل شيء خلال خمس دقائق
Dialogue: 0,0:08:07.57,0:08:14.67,Default,,0,0,0,,،هـ-هذا! إن هزمناه\N!فسنتمكن من عبور هذا التل
Dialogue: 0,0:08:22.55,0:08:24.92,Default,,0,0,0,,!كانت الأفضلية لنا قبل قليل
Dialogue: 0,0:08:24.92,0:08:27.49,Default,,0,0,0,,!سنقطعه خلال خمس دقائق
Dialogue: 0,0:08:27.49,0:08:31.16,Default,,0,0,0,,!أعتمد عليكما أيّها الأخوان مياوبان
Dialogue: 0,0:08:34.36,0:08:35.86,Default,,0,0,0,,!زورو
Dialogue: 0,0:08:39.53,0:08:42.07,Default,,0,0,0,,!ماذا؟-\N!أ-أيّتها الحمقاء-
Dialogue: 0,0:08:42.07,0:08:45.47,Default,,0,0,0,,!تركلين سيفيّ الآن أيضًا؟
Dialogue: 0,0:08:45.47,0:08:47.91,Default,,0,0,0,,أين شكري؟
Dialogue: 0,0:08:47.91,0:08:50.44,Default,,0,0,0,,...أجل
Dialogue: 0,0:08:50.44,0:08:52.11,Default,,0,0,0,,!شكرًا لك
Dialogue: 0,0:08:54.71,0:08:57.38,Default,,0,0,0,,!لا فائدة حتى وإن استخدمت ثلاثة سيوف
Dialogue: 0,0:08:57.38,0:08:59.55,Default,,0,0,0,,!قدرتك هي نفسها
Comment: 0,0:09:01.22,0:09:02.72,Default2,,0,0,0,karaoke,{\k150}فخ
Comment: 0,0:09:08.29,0:09:09.80,Default2,,0,0,0,karaoke,{\k151}!النمر
Dialogue: 0,0:09:05.49,0:09:08.29,Default,,0,0,0,,...لا تفهمان
Dialogue: 0,0:09:14.40,0:09:17.07,Default,,0,0,0,,.تبقت أربع دقائق
Dialogue: 0,0:09:20.07,0:09:23.84,Default,,0,0,0,,مجرد امتلاك ثلاثة سيوف مختلف
Dialogue: 0,0:09:23.84,0:09:26.51,Default,,0,0,0,,!عن معرفة أسلوب الثلاثة سيوف
Dialogue: 0,0:09:35.69,0:09:37.52,Default,,0,0,0,,...إنّه قوي
Dialogue: 0,0:09:41.36,0:09:43.36,Default,,0,0,0,,...ضربة واحدة
Dialogue: 0,0:09:52.14,0:09:56.14,Default,,0,0,0,,!هـ-هزم الأخوين مياوبان بضربة واحدة
Dialogue: 0,0:10:06.79,0:10:09.39,Default,,0,0,0,,!لا تقلق
Dialogue: 0,0:10:09.39,0:10:16.10,Default,,0,0,0,,سأسحقكم جميعًا دون\N!الحاجة لانتظار خمس دقائق
Dialogue: 0,0:10:27.64,0:10:29.98,Default,,0,0,0,,.تبقت ثلاث دقائق
Dialogue: 0,0:10:36.78,0:10:40.45,Default,,0,0,0,,...سوف... أقتله
Dialogue: 0,0:10:43.62,0:10:45.69,Default,,0,0,0,,...أ-أيّها القائد
Dialogue: 0,0:10:45.69,0:10:49.36,Default,,0,0,0,,...نوّمني مغناطيسيًا
Dialogue: 0,0:10:50.83,0:10:53.93,Default,,0,0,0,,!أ-أرجوك أيّها القائد
Dialogue: 0,0:10:53.93,0:10:57.84,Default,,0,0,0,,.إنّه حي. عملك غير متقن
Dialogue: 0,0:10:59.97,0:11:03.98,Default,,0,0,0,,...شحمه القوي أنقذه إذًا
Dialogue: 0,0:11:24.50,0:11:26.57,Default,,0,0,0,,!نل منه يا بوتشي
Dialogue: 0,0:11:31.94,0:11:34.27,Default,,0,0,0,,!تنويم مغناطيسي ثانية؟
Dialogue: 0,0:11:38.08,0:11:42.75,Default,,0,0,0,,إنّه مزعج! كان بإمكانه\N!تحطيم الأرض دون شيء
Dialogue: 0,0:11:45.42,0:11:47.82,Default,,0,0,0,,!ما الذي سيحدث إن زادت قوته؟
Dialogue: 0,0:11:57.06,0:11:58.73,Default,,0,0,0,,!هذه فرصتي
Dialogue: 0,0:11:58.73,0:12:02.07,Default,,0,0,0,,!عليّ أن أوقظه بينما الفرصة سانحة لي
Dialogue: 0,0:12:02.07,0:12:07.81,Default,,0,0,0,,ما الذي تنوي فعله الآن\Nتلك المرأة الماكرة؟
Dialogue: 0,0:12:12.98,0:12:17.18,Default,,0,0,0,,!تكبّد الجميع إصابات خطيرة بينما هو مستلقٍ هنا
Dialogue: 0,0:12:20.49,0:12:21.99,Default,,0,0,0,,!موتي
Dialogue: 0,0:12:30.20,0:12:31.83,Default,,0,0,0,,!انهض
Dialogue: 0,0:12:31.83,0:12:33.83,Default,,0,0,0,,!نامي! احترسي
Dialogue: 0,0:12:40.34,0:12:42.98,Default,,0,0,0,,.تبقت دقيقتان
Dialogue: 0,0:12:59.36,0:13:01.09,Default,,0,0,0,,!انهض
Dialogue: 0,0:13:01.09,0:13:03.10,Default,,0,0,0,,!نامي! احترسي
Dialogue: 0,0:13:07.07,0:13:08.80,Default,,0,0,0,,!تقطّعي إلى نصفين
Dialogue: 0,0:13:10.07,0:13:11.60,Default,,0,0,0,,!تفاديها
Dialogue: 0,0:13:13.51,0:13:15.11,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:13:16.21,0:13:20.25,Default,,0,0,0,,!تشاكرام! لم تكن مجرد أداة تنويم مغناطيسي؟
Dialogue: 0,0:13:21.25,0:13:25.72,Default,,0,0,0,,!نامي! كيف تجرئين على الدوس على وجهي
Dialogue: 0,0:13:34.59,0:13:37.43,Default,,0,0,0,,!إ-إنّه حي؟
Dialogue: 0,0:13:37.43,0:13:42.10,Default,,0,0,0,,...لا أدري ما إن كان توقيتًا سيّئًا أم جيّدًا
Dialogue: 0,0:13:51.41,0:13:53.08,Default,,0,0,0,,...لـ-لوفي
Dialogue: 0,0:13:58.18,0:13:59.85,Default,,0,0,0,,!لوفي
Dialogue: 0,0:13:59.85,0:14:01.89,Default,,0,0,0,,...مؤلم
Dialogue: 0,0:14:02.82,0:14:05.73,Default,,0,0,0,,!مؤلم
Dialogue: 0,0:14:05.73,0:14:08.09,Default,,0,0,0,,!عـ-عاد للحياة
Dialogue: 0,0:14:08.09,0:14:13.53,Default,,0,0,0,,!هذا سيّئ-\N!خمس دقائق لن تكفينا أبدًا الآن-
Dialogue: 0,0:14:13.53,0:14:16.60,Default,,0,0,0,,!نامي! هذا مؤلم أيّتها اللعينة
Dialogue: 0,0:14:16.60,0:14:18.84,Default,,0,0,0,,!لم أفعل ذلك
Dialogue: 0,0:14:18.84,0:14:21.57,Default,,0,0,0,,...لم أفعل ذلـ
Dialogue: 0,0:14:23.88,0:14:27.55,Default,,0,0,0,,نـ-نامي؟ هل آذيتِ كتفك؟
Dialogue: 0,0:14:27.55,0:14:30.68,Default,,0,0,0,,...هـ-هذا لا شيء. أنا بخير
Dialogue: 0,0:14:30.68,0:14:37.12,Default,,0,0,0,,على أيّ حال، فعلت كل ما يمكنني\N...فعله الآن. أترك الباقي عليك
Dialogue: 0,0:14:39.39,0:14:43.30,Default,,0,0,0,,...لا يمكننا أن نخسر هذا القتال أبدًا
Dialogue: 0,0:14:43.30,0:14:44.53,Default,,0,0,0,,!أجل
Dialogue: 0,0:14:44.53,0:14:46.73,Default,,0,0,0,,!من أجل الكنز
Dialogue: 0,0:14:49.34,0:14:52.61,Default,,0,0,0,,!ستسير الأمور على ما يرام
Dialogue: 0,0:14:52.61,0:14:56.08,Default,,0,0,0,,!ابذل جهدك! من أجل كنزي
Dialogue: 0,0:14:56.08,0:14:59.41,Default,,0,0,0,,!حسنًا! هذه هي طباعك بالفعل
Dialogue: 0,0:15:00.48,0:15:03.15,Default,,0,0,0,,.تبقت دقيقة
Dialogue: 0,0:15:05.25,0:15:07.12,Default,,0,0,0,,!هذا مستحيل
Dialogue: 0,0:15:07.12,0:15:09.76,Default,,0,0,0,,...حتّى القائد جانغو وبوتشي-سان
Dialogue: 0,0:15:09.76,0:15:13.23,Default,,0,0,0,,!لا يستطيعان هزيمتهما خلال دقيقة
Dialogue: 0,0:15:28.37,0:15:32.04,Default,,0,0,0,,!بوتشي! لا نملك الوقت للتفكير
Dialogue: 0,0:15:32.04,0:15:34.25,Default,,0,0,0,,!اقتل أنتَ صاحب الهاماراكي الوغد
Dialogue: 0,0:15:34.25,0:15:38.78,Default,,0,0,0,,...وأنا سأتعامل مع ذلك الطفل الغريب
Dialogue: 0,0:15:45.06,0:15:47.06,Default,,0,0,0,,!سأقتل قبعة القش
Dialogue: 0,0:15:52.87,0:15:56.74,Default,,0,0,0,,.حان وقت قتل الجميع
Dialogue: 0,0:16:09.78,0:16:13.92,Default,,0,0,0,,!ماذا؟ الخادم الشرير هنا أيضًا
Dialogue: 0,0:16:13.92,0:16:15.69,Default,,0,0,0,,...أليس هذا
Dialogue: 0,0:16:15.69,0:16:18.31,Default,,0,0,0,,ألم يقع من الجرف ومات؟
Dialogue: 0,0:16:19.99,0:16:21.99,Default,,0,0,0,,.لا يهم
Dialogue: 0,0:16:33.71,0:16:35.71,Default,,0,0,0,,...لا تقتربي
Dialogue: 0,0:16:38.78,0:16:40.81,Default,,0,0,0,,!من خلفي
Dialogue: 0,0:16:41.91,0:16:43.65,Default,,0,0,0,,!كايا
Dialogue: 0,0:17:00.13,0:17:02.74,Default,,0,0,0,,!أ-أوسوب-سان! هل أنت بخير؟
Dialogue: 0,0:17:02.74,0:17:06.31,Default,,0,0,0,,!كـ-كايا... لماذا أتيتِ إلى هنا؟
Dialogue: 0,0:17:06.31,0:17:08.54,Default,,0,0,0,,...آسفة يا أوسوب-سان
Dialogue: 0,0:17:08.54,0:17:11.34,Default,,0,0,0,,،لا بد أنّك لن تسامحني وإن اعتذرت
Dialogue: 0,0:17:11.34,0:17:13.98,Default,,0,0,0,,...ولكنّي لم أتمكن من تصديقك أبدًا
Dialogue: 0,0:17:13.98,0:17:16.52,Default,,0,0,0,,...كـ-كلاهادور قرصان
Dialogue: 0,0:17:16.52,0:17:20.25,Default,,0,0,0,,!هذا ليس مهمًا\N!لماذا أتيتِ إلى هنا؟
Dialogue: 0,0:17:20.25,0:17:22.19,Default,,0,0,0,,!أخبرتك أن تهربي
Dialogue: 0,0:17:22.19,0:17:24.56,Default,,0,0,0,,!حياتك مستهدفة
Dialogue: 0,0:17:24.56,0:17:28.23,Default,,0,0,0,,!ولكنّك تقاتل
Dialogue: 0,0:17:29.86,0:17:33.57,Default,,0,0,0,,،حتّى بعد معاملتي لك بشكل مروّع
Dialogue: 0,0:17:33.57,0:17:37.47,Default,,0,0,0,,...فإنّك ما زلت تقاتل على الرغم من كلّ هذه الجروح
Dialogue: 0,0:17:37.47,0:17:40.34,Default,,0,0,0,,...آنسة كايا
Dialogue: 0,0:17:40.34,0:17:43.11,Default,,0,0,0,,لماذا أنتِ هنا؟
Dialogue: 0,0:17:45.24,0:17:48.15,Default,,0,0,0,,...تـ-توقف
Dialogue: 0,0:17:51.25,0:17:54.85,Default,,0,0,0,,!توقف يا كلاهادور
Dialogue: 0,0:18:01.06,0:18:04.73,Default,,0,0,0,,.أخبرني ميري عن كلّ شيء
Dialogue: 0,0:18:09.50,0:18:12.27,Default,,0,0,0,,أليست هذه فتاة القصر؟
Dialogue: 0,0:18:12.27,0:18:15.21,Default,,0,0,0,,!أيعني ذلك أنّ هذه هي آخر هدف في الخطة؟
Dialogue: 0,0:18:15.21,0:18:17.94,Default,,0,0,0,,إذًا لا داعي للذهاب إلى القرية الآن؟
Dialogue: 0,0:18:17.94,0:18:20.95,Default,,0,0,0,,!علينا أن نقتلها فحسب، أليس كذلك؟
Dialogue: 0,0:18:23.28,0:18:27.72,Default,,0,0,0,,أرجوك يا كلاهادور... إن أردت\N!ثروتي، فسأعطيك إيّاها كلها
Dialogue: 0,0:18:27.72,0:18:32.02,Default,,0,0,0,,!لذلك اخرج من هذه القرية، الآن
Dialogue: 0,0:18:32.02,0:18:36.63,Default,,0,0,0,,...سأقبل هذا بامتنان، ولكن
Dialogue: 0,0:18:36.63,0:18:41.87,Default,,0,0,0,,...هناك شيء آخر أريده
Dialogue: 0,0:18:43.37,0:18:47.24,Default,,0,0,0,,...ما أريده هو
Dialogue: 0,0:18:47.24,0:18:50.11,Default,,0,0,0,,.السكينة
Dialogue: 0,0:18:50.11,0:18:52.71,Default,,0,0,0,,السكينة؟
Dialogue: 0,0:18:52.71,0:18:57.58,Default,,0,0,0,,.صحيح. كل ما أريده هو السكينة
Dialogue: 0,0:18:57.58,0:19:01.59,Default,,0,0,0,,أجد أنّ ثقة القرويين التي\Nعززتها خلال الثلاث سنوات الماضية
Dialogue: 0,0:19:01.59,0:19:07.09,Default,,0,0,0,,.لطيفة ومريحة الآن
Dialogue: 0,0:19:07.09,0:19:13.77,Default,,0,0,0,,.لذلك، أريد هذه السكينة إلى الأبد
Dialogue: 0,0:19:20.64,0:19:22.84,Default,,0,0,0,,...لذلك
Dialogue: 0,0:19:22.84,0:19:29.28,Default,,0,0,0,,!لذلك سأحصل على تلك الطمأنينة\N...وثروتك أيضًا
Dialogue: 0,0:19:29.28,0:19:32.28,Default,,0,0,0,,!باختصار، سيأتي القراصنة إلى القرية
Dialogue: 0,0:19:34.75,0:19:36.22,Default,,0,0,0,,...وأيضًا
Dialogue: 0,0:19:36.22,0:19:39.76,Default,,0,0,0,,!ستتركين وصيتك وتموتين
Dialogue: 0,0:19:39.76,0:19:43.80,Default,,0,0,0,,.هذان الشيئان حتميان
Dialogue: 0,0:19:43.80,0:19:46.80,Default,,0,0,0,,...كـ-كلا
Dialogue: 0,0:19:46.80,0:19:49.77,Default,,0,0,0,,...أ-أنت
Dialogue: 0,0:19:49.77,0:19:51.70,Default,,0,0,0,,!اهربي! اهربي يا كايا
Dialogue: 0,0:19:51.70,0:19:55.04,Default,,0,0,0,,!لا فائدة من الحديث معه! اهربي
Dialogue: 0,0:19:55.04,0:20:01.28,Default,,0,0,0,,.لـ-لست كلاهادور\N...لست كلاهادور
Dialogue: 0,0:20:01.28,0:20:03.28,Default,,0,0,0,,...كايا
Dialogue: 0,0:20:06.19,0:20:09.12,Default,,0,0,0,,!غادر هذه القرية
Dialogue: 0,0:20:09.12,0:20:13.29,Default,,0,0,0,,...تصوّبين مسدسًا عليّ
Dialogue: 0,0:20:13.29,0:20:16.26,Default,,0,0,0,,!غادر حالًا
Dialogue: 0,0:20:16.26,0:20:22.77,Default,,0,0,0,,...فهمت. نضجتِ كثيرًا خلال هذه الثلاث سنوات
Dialogue: 0,0:20:22.77,0:20:25.84,Default,,0,0,0,,.يا الآنسة كايا
Dialogue: 0,0:20:25.84,0:20:32.28,Default,,0,0,0,,هل تذكرين؟ حدثت الكثير\N...من الأمور خلال ثلاث سنوات
Dialogue: 0,0:20:32.28,0:20:36.68,Default,,0,0,0,,،قضينا الكثير من الوقت معًا
Dialogue: 0,0:20:36.68,0:20:41.39,Default,,0,0,0,,حتى قبل وفاة والديك\N...وقبل أن تصبحي طريحة الفراش
Dialogue: 0,0:20:41.39,0:20:43.39,Default,,0,0,0,,...الكثير حقًا
Dialogue: 0,0:20:46.59,0:20:49.36,Default,,0,0,0,,...أتذكر الكثير... عانينا معًا
Dialogue: 0,0:20:49.36,0:20:53.10,Default,,0,0,0,,...فرحنا معًا
Dialogue: 0,0:20:53.10,0:20:56.60,Default,,0,0,0,,...كـ-كلاهادور
Dialogue: 0,0:20:56.60,0:20:59.41,Default,,0,0,0,,،كنت أزور المدينة برفقتك
Dialogue: 0,0:20:59.41,0:21:03.18,Default,,0,0,0,,،وكلّما عانيتِ من نزلة برد\N...كنت أعتني بك باستمرار
Dialogue: 0,0:21:03.18,0:21:09.35,Default,,0,0,0,,...كنتِ تستمعين إلى أحاديثي بكلّ سرور
Dialogue: 0,0:21:09.35,0:21:13.55,Default,,0,0,0,,...كرّست نفسي لك
Dialogue: 0,0:21:13.55,0:21:15.29,Default,,0,0,0,,...لوقت طويل
Dialogue: 0,0:21:15.29,0:21:20.29,Default,,0,0,0,,...صحيحٌ أنّي قاومت ذلك لوقت طويل
Dialogue: 0,0:21:21.89,0:21:29.13,Default,,0,0,0,,...صحيح أنّ كلّ ذلك كان لأجل قتلك اليوم
Dialogue: 0,0:21:35.61,0:21:39.91,Default,,0,0,0,,،أنا، الرجل الذي كان معروفًا باسم القائد كورو
Dialogue: 0,0:21:39.91,0:21:45.02,Default,,0,0,0,,...اضطررت للتبسم بودّ لفتاة تافهة
Dialogue: 0,0:21:45.02,0:21:49.25,Default,,0,0,0,,!تحركت ضد طبيعتي وتملقتك
Dialogue: 0,0:21:53.86,0:21:55.99,Default,,0,0,0,,...أيّها الوغد
Dialogue: 0,0:21:55.99,0:22:00.30,Default,,0,0,0,,!أتفهمين تلك الإهانات اليومية؟
Dialogue: 0,0:22:00.30,0:22:05.64,Default,,0,0,0,,أتفهمين أنّ هذا الرجل كان\N!يعرف باسم القائد كورو؟
Dialogue: 0,0:22:13.11,0:22:15.81,Default,,0,0,0,,!كورو
Dialogue: 0,0:22:22.02,0:22:24.62,Default,,0,0,0,,...صحيح
Dialogue: 0,0:22:26.56,0:22:30.50,Default,,0,0,0,,.ما زلتُ أضمرُ لك الضّغنية على ضربك لي
Dialogue: 0,0:22:30.50,0:22:32.36,Default,,0,0,0,,!أوسوب-سان
Dialogue: 0,0:22:32.36,0:22:37.37,Default,,0,0,0,,ضربتني بكلّ قوتك في \N...تلك المرة حسب ما أذكر
Dialogue: 0,0:23:02.19,0:23:07.00,Default,,0,0,0,,،إن كنت تكره أن تُضرب إلى هذه الدرجة\N!فسأضربك مئة مرة
Dialogue: 0,0:23:10.00,0:23:24.25,OS,,0,0,0,,عندما كنت صغيرًا، راودتني رؤية عن خريطة كنز
Dialogue: 0,0:23:24.25,0:23:31.19,OS,,0,0,0,,ولطالما بحثت عن ذلك المكان الإعجازي
Dialogue: 0,0:23:31.19,0:23:38.36,OS,,0,0,0,,لكي لا يسبقني أحد آخر إليه
Dialogue: 0,0:23:41.03,0:23:52.51,OS,,0,0,0,,إن كان العالم سيتغير
Dialogue: 0,0:23:52.51,0:23:59.52,OS,,0,0,0,,قبل أن أحقق حلمي
Dialogue: 0,0:23:59.52,0:24:06.59,OS,,0,0,0,,فخذوني إلى الوقت الذي كنت فيه جاهلًا
Dialogue: 0,0:24:06.59,0:24:19.97,OS,,0,0,0,,لكي لا تمحى ذكرياتي
Dialogue: 0,0:24:25.64,0:24:29.85,Default,,0,0,0,,!أوسوب! اذهب أنت لإنقاذ الآنسة كايا\N!اترك أمر الخادم الشرير لي
Dialogue: 0,0:24:29.85,0:24:32.95,Default,,0,0,0,,!يا له من شرير لا أمل من إنقاذ قلبه-\N!ولكنّي لا أنوي إنقاذه-
Dialogue: 0,0:24:32.95,0:24:34.65,Default,,0,0,0,,!سأسعى وراء ذلك المنوّم المغناطيسي اللعين
Dialogue: 0,0:24:34.65,0:24:37.56,Default,,0,0,0,,!كورو! أنت لست جديرًا بأن تكون قرصانًا
Dialogue: 0,0:24:37.56,0:24:40.56,Default,,0,0,0,,!طموحي أعظم من طموحك
Dialogue: 0,0:24:40.56,0:24:42.03,Default,,0,0,0,,:في الحلقة القادمة من ون بيس
Dialogue: 0,0:24:42.03,0:24:45.66,Default,,0,0,0,,!اهزم كورو! عزيمة الرجل أوسوب الباكية
Dialogue: 0,0:24:45.66,0:24:48.33,Default,,0,0,0,,!ملك القراصنة، لن يكون إلاّ أنا
Dialogue: 0,0:24:46.63,0:24:50.05,Ep Title,,0,0,0,,{\fs50}!اهزم كورو! عزيمة الرجل أوسوب الباكية
